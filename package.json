{
  "author": "Zebec Network | Ashish Sapkota",
  "dependencies": {
    "@provablehq/sdk": "^0.11.6",
    "bignumber.js": "^11.1.5"
  },
  "description": "TypeScript SDK for the test_zebec_payroll_v2.aleo program",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "dotenv": "^17.4.2",
    "mocha": "^11.7.6",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "zebec-payroll-sdk",
  "scripts": {
    "build": "leo build",
    "clean": "leo clean",
    "run:admin": "tsx scripts/admin.ts",
    "run:deploy": "tsx scripts/deploy.ts",
    "run:payroll": "tsx scripts/payroll.ts",
    "run:upgrade": "tsx scripts/upgrade.ts",
    "sdk:build": "npm run sdk:clean && tsc -p tsconfig.json",
    "sdk:clean": "rm -rf dist .test-dist",
    "sdk:test:integration": "ts-mocha -p tsconfig.test.json --timeout 600000 '.test-dist/sdk-tests/integration/**/*.test.js'",
    "sdk:test:unit": "tsc -p tsconfig.test.json && mocha '.test-dist/sdk-tests/unit/**/*.test.js'"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "1.0.0"
}