NETWORK=testnet
PRIVATE_KEY=
RECEIVER_PRIVATE_KEY=
ENDPOINT=https://api.explorer.provable.com/v1
# Optional: base URI of a delegated proving service. When set, transactions
# are proven remotely instead of locally — recommended on machines without
# enough RAM/CPU for local proving-key synthesis.
# Provable's DPS: PROVER_URI=https://api.provable.com/prove/testnet
PROVER_URI=
# Required for Provable's DPS (register free at
# POST https://api.provable.com/consumers with {"username": "<handle>"}).
# Not needed for a self-hosted prover.
PROVER_API_KEY=
PROVER_CONSUMER_ID=
