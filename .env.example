NETWORK=testnet
# Deployer private key
PRIVATE_KEY=

# Payroll Admin private key
ADMIN_PRIVATE_KEY=
# Payroll sender private key
SENDER_PRIVATE_KEY=
# Payroll receiver private key
RECEIVER_PRIVATE_KEY=

ENDPOINT=https://api.provable.com/v2
# Optional: base URI of a delegated proving service. When set, transactions
# are proven remotely instead of locally — recommended on machines without
# enough RAM/CPU for local proving-key synthesis.
# Provable's DPS: PROVER_URI=https://api.provable.com/prove/testnet
PROVER_URI=https://api.provable.com/prove
# Optional: base URI of record scanner
RECORD_SCANNER_URI=https://api.provable.com/scanner
# Required for Provable's DPS (register free at
# POST https://api.provable.com/consumers with {"username": "<handle>"}).
# Not needed for a self-hosted prover.
PROVABLE_API_KEY=
PROVABLE_CONSUMER_ID=
# set 1 to enable public stream in the scripts
PUBLIC_STREAM=