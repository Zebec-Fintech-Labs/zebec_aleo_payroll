{
  "name": "aacs-payroll-sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for the aacs_payroll.aleo program",
  "license": "MIT",
  "author": "Ashish Sapkota",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && mocha \".test-dist/test/unit/**/*.test.js\"",
    "test:integration": "tsc -p tsconfig.test.json && mocha --timeout 600000 \".test-dist/test/integration/**/*.test.js\"",
    "clean": "rm -rf dist .test-dist"
  },
  "dependencies": {
    "@provablehq/sdk": "^0.11.6"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "mocha": "^11.7.6",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
