{
  // Test build: compiles src + test into .test-dist as plain ESM JavaScript,
  // which mocha then runs directly (no ts-node/ts-mocha needed).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./.test-dist",
    "declaration": false,
    "sourceMap": true
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src", "test"]
}
